{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Workshop: conectar main/Core (127.0.0.1:9229)",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9229,
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/dist-debug/desktop/main/**/*.js",
        "${workspaceFolder}/dist-debug/core/**/*.js"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/dist-debug/**",
        "!**/node_modules/**"
      ],
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ]
    },
    {
      "name": "Workshop: Desktop (main + Core)",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "Workshop: Preparar",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/electron/dist/electron",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/electron/dist/electron.exe"
      },
      "osx": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/electron/dist/Electron.app/Contents/MacOS/Electron"
      },
      "args": [
        "${workspaceFolder}/dist-debug",
        "--repo=C:/Dev/GitLayerTest",
        "--lab-profile=${workspaceFolder}/.workshop/profiles/debug"
      ],
      "env": {
        "ELECTRON_RUN_AS_NODE": null
      },
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/dist-debug/desktop/main/**/*.js",
        "${workspaceFolder}/dist-debug/core/**/*.js"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/dist-debug/**",
        "!**/node_modules/**"
      ],
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "outputCapture": "std",
      "console": "internalConsole"
    },
    {
      "name": "Workshop: Desktop com porta renderer local",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "Workshop: Preparar",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/electron/dist/electron",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/electron/dist/electron.exe"
      },
      "osx": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/electron/dist/Electron.app/Contents/MacOS/Electron"
      },
      "args": [
        "--remote-debugging-address=127.0.0.1",
        "--remote-debugging-port=9222",
        "${workspaceFolder}/dist-debug",
        "--repo=C:/Dev/GitLayerTest",
        "--lab-profile=${workspaceFolder}/.workshop/profiles/debug"
      ],
      "env": {
        "ELECTRON_RUN_AS_NODE": null
      },
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/dist-debug/desktop/main/**/*.js",
        "${workspaceFolder}/dist-debug/core/**/*.js"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/dist-debug/**",
        "!**/node_modules/**"
      ],
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "outputCapture": "std",
      "console": "internalConsole"
    },
    {
      "name": "Workshop: anexar renderer (127.0.0.1:9222)",
      "type": "pwa-chrome",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9222,
      "timeout": 120000,
      "urlFilter": "gitlayers://app/*",
      "webRoot": "${workspaceFolder}/dist-debug/renderer",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "gitlayers-workshop:///*": "${workspaceFolder}/*"
      },
      "resolveSourceMapLocations": [
        "${workspaceFolder}/dist-debug/renderer/**",
        "gitlayers://app/**",
        "!**/node_modules/**"
      ],
      "skipFiles": [
        "**/node_modules/**"
      ]
    },
    {
      "name": "Workshop: CLI (status da demonstração)",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "Workshop: Preparar",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/dist-debug/cli/index.js",
      "args": [
        "--cwd",
        "C:/Dev/GitLayerTest",
        "status",
        "--json"
      ],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/dist-debug/cli/**/*.js",
        "${workspaceFolder}/dist-debug/core/**/*.js"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/dist-debug/**",
        "!**/node_modules/**"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Workshop: teste selecionado (arquivo tests/*.test.*)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": [
        "--import",
        "tsx",
        "--test",
        "--test-concurrency=1"
      ],
      "args": [
        "${file}"
      ],
      "autoAttachChildProcesses": true,
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Workshop: conectar ao botão Debug",
      "configurations": [
        "Workshop: conectar main/Core (127.0.0.1:9229)",
        "Workshop: anexar renderer (127.0.0.1:9222)"
      ],
      "stopAll": true
    },
    {
      "name": "Workshop: main + renderer (debug local)",
      "configurations": [
        "Workshop: Desktop com porta renderer local",
        "Workshop: anexar renderer (127.0.0.1:9222)"
      ],
      "stopAll": true
    }
  ]
}
