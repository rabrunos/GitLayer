{
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "debug.javascript.autoAttachFilter": "disabled",
  "search.exclude": {
    "**/node_modules": true,
    "dist": true,
    "dist-debug": true,
    "artifacts": true,
    ".workshop": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/artifacts/**": true,
    "**/.workshop/**": true
  },
  "files.exclude": {
    "**/node_modules": true
  },
  "npm.packageManager": "npm",
  "VsCodeTaskButtons.showCounter": false,
  "VsCodeTaskButtons.tasks": [
    {
      "label": "$(debug-start) Dev",
      "task": "Workshop: Dev",
      "tooltip": "Compilar, abrir e atualizar ao salvar as fontes"
    },
    {
      "label": "$(debug-alt) Debug",
      "task": "Workshop: Debug",
      "tooltip": "Iniciar com inspectors; conectar pelo F5 sem outra instância"
    },
    {
      "label": "$(tools) Workshop",
      "tooltip": "Preparar, diagnosticar, testar e empacotar",
      "tasks": [
        {
          "label": "Abrir sem observar fontes",
          "task": "Workshop: Abrir"
        },
        {
          "label": "Testes unitários rápidos",
          "task": "Workshop: Testes rápidos"
        },
        {
          "label": "Preparar ambiente e demonstração",
          "task": "Workshop: Preparar"
        },
        {
          "label": "Diagnosticar ambiente",
          "task": "Workshop: Diagnosticar"
        },
        {
          "label": "Smoke Core/CLI",
          "task": "Workshop: Smoke"
        },
        {
          "label": "Suíte completa",
          "task": "Workshop: Testes"
        },
        {
          "label": "Testar interface",
          "task": "Workshop: Interface"
        },
        {
          "label": "Typecheck",
          "task": "Workshop: Typecheck"
        },
        {
          "label": "Build debug",
          "task": "Workshop: Build debug"
        },
        {
          "label": "Build produção",
          "task": "Workshop: Build produção"
        },
        {
          "label": "Gerar pacote Windows",
          "task": "Workshop: Pacote Windows"
        },
        {
          "label": "Verificar sourcemaps",
          "task": "Workshop: Verificar mapas"
        },
        {
          "label": "Verificação completa Core/CLI",
          "task": "Workshop: Verificar tudo"
        }
      ]
    }
  ]
}
