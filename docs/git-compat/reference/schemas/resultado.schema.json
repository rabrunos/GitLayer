{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Git Layer - registro de resultado por variante - proposta v2",
  "description": "Proposta de schema a implementar/adaptar pelo Codex, sem resultados reais incluídos. As regras de proveniência/contagens/links devem ter validação adicional.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "scenario_id",
    "variant_id",
    "phase",
    "scope",
    "requirement_ids",
    "implementation_status",
    "selection_status",
    "execution_status",
    "product_status",
    "known_failure",
    "known_issue_id",
    "source_fingerprint",
    "runner_fingerprint",
    "environment_path",
    "started_at",
    "ended_at",
    "duration_ms",
    "commands",
    "assertions",
    "evidence",
    "reproduction",
    "nonexecution_reason",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3,}$"
    },
    "variant_id": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "NATIVE_BASELINE",
        "CURRENT_PRODUCT",
        "USER_REQUIREMENT",
        "HARNESS",
        "SPECIFICATION"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "implementation_status": {
      "enum": [
        "SPEC_ONLY",
        "IMPLEMENTED"
      ]
    },
    "selection_status": {
      "enum": [
        "SELECTED",
        "NOT_SELECTED",
        "OUT_OF_SCOPE_CURRENT_PHASE"
      ]
    },
    "execution_status": {
      "enum": [
        "NOT_RUN",
        "PASS",
        "FAIL",
        "ENV_BLOCKED",
        "NOT_APPLICABLE"
      ]
    },
    "product_status": {
      "enum": [
        "NOT_ASSESSED",
        "PENDING_PRODUCT_SPEC",
        "TEST_GAP",
        "PRODUCT_GAP",
        "DOCUMENTED_RESTRICTION",
        "VERIFIED_SUPPORTED"
      ]
    },
    "known_failure": {
      "enum": [
        "NONE",
        "XFAIL_STRICT",
        "XPASS_NEEDS_REVIEW"
      ]
    },
    "known_issue_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "runner_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "environment_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "duration_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "executable",
          "argv",
          "cwd",
          "exit_code",
          "timed_out",
          "signal",
          "stdout_path",
          "stderr_path"
        ],
        "properties": {
          "executable": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "timed_out": {
            "type": "boolean"
          },
          "signal": {
            "type": [
              "string",
              "null"
            ]
          },
          "stdout_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "stderr_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "stdin_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "sanitization_map_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected_exit_codes": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "output_truncated": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "expected",
          "observed",
          "passed",
          "evidence_paths"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "expected": {},
          "observed": {},
          "passed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "evidence_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contract_source": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Caminho relativo dentro do pacote. Validador do runner também deve recusar travessia, absoluto, link e destino ausente."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "reproduction": {
      "type": "object",
      "required": [
        "command",
        "seed",
        "fixture_recipe_path"
      ],
      "properties": {
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "seed": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "fixture_recipe_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "nonexecution_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "selection_status": {
            "enum": [
              "NOT_SELECTED",
              "OUT_OF_SCOPE_CURRENT_PHASE"
            ]
          }
        },
        "required": [
          "selection_status"
        ]
      },
      "then": {
        "properties": {
          "execution_status": {
            "const": "NOT_RUN"
          },
          "nonexecution_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "implementation_status": {
            "const": "SPEC_ONLY"
          }
        },
        "required": [
          "implementation_status"
        ]
      },
      "then": {
        "properties": {
          "execution_status": {
            "const": "NOT_RUN"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "properties": {
          "implementation_status": {
            "const": "IMPLEMENTED"
          },
          "selection_status": {
            "const": "SELECTED"
          },
          "source_fingerprint": {
            "type": "string",
            "minLength": 1
          },
          "runner_fingerprint": {
            "type": "string",
            "minLength": 1
          },
          "environment_path": {
            "type": "string",
            "minLength": 1
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "ended_at": {
            "type": "string",
            "format": "date-time"
          },
          "duration_ms": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "PASS"
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "properties": {
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "allOf": [
                {
                  "type": "object",
                  "required": [
                    "id",
                    "expected",
                    "observed",
                    "passed",
                    "evidence_paths"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string"
                    },
                    "expected": {},
                    "observed": {},
                    "passed": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "evidence_paths": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "contract_source": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "additionalProperties": true
                },
                {
                  "properties": {
                    "passed": {
                      "const": true
                    }
                  }
                }
              ]
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256",
                "bytes"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Caminho relativo dentro do pacote. Validador do runner também deve recusar travessia, absoluto, link e destino ausente."
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "description": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "enum": [
              "NOT_RUN",
              "ENV_BLOCKED",
              "NOT_APPLICABLE"
            ]
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "properties": {
          "nonexecution_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "known_failure": {
            "const": "XFAIL_STRICT"
          }
        },
        "required": [
          "known_failure"
        ]
      },
      "then": {
        "properties": {
          "execution_status": {
            "const": "FAIL"
          },
          "known_issue_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "known_failure": {
            "const": "XPASS_NEEDS_REVIEW"
          }
        },
        "required": [
          "known_failure"
        ]
      },
      "then": {
        "properties": {
          "execution_status": {
            "const": "PASS"
          },
          "known_issue_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "product_status": {
            "const": "VERIFIED_SUPPORTED"
          }
        },
        "required": [
          "product_status"
        ]
      },
      "then": {
        "properties": {
          "execution_status": {
            "const": "PASS"
          },
          "implementation_status": {
            "const": "IMPLEMENTED"
          },
          "phase": {
            "enum": [
              "CURRENT_PRODUCT",
              "USER_REQUIREMENT"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
